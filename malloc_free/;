char *create_array(unsigned int size, char c)
{
	char *array;
	int index;

	array = malloc(sizeof(char) * size);

	index = 0;

	while (array[index] != '\0')
	{
		array[index] = c;
		index++;
	}

	if (size == 0)
	{
		return (NULL);
	}
	return (array);
}
